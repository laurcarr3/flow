{
  "name": "@local/flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Approved feature documents to independently reviewed draft PRs",
  "bin": {
    "flow": "dist/main.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/main.ts",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "commander": "^14.0.0",
    "mcp-remote": "^0.1.31",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.20.0"
}
